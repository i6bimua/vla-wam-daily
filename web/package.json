    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.9.0"
