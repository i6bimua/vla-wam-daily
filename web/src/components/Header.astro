---
import { TOPIC_ROUTES } from "../lib/topics";

const base = import.meta.env.BASE_URL;
const repository = import.meta.env.GITHUB_REPOSITORY;
const repositoryUrl = repository ? `https://github.com/${repository}` : null;
const links = [
  ...TOPIC_ROUTES.map((route) => ({
    label: route.navLabel,
    path: `topics/${route.slug}/`,
  })),
  { label: "本周精选", path: "weekly/" },
  { label: "归档", path: "archive/" },
  { label: "搜索", path: "search/" },
  { label: "RSS", path: "rss.xml" },
  { label: "方法", path: "methodology/" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={base} aria-label="VLA/WAM Daily 首页">
      <span class="brand__mark" aria-hidden="true">V/W</span>
      <span>
        <strong>VLA/WAM Daily</strong>
        <small>Robotics research brief</small>
      </span>
    </a>
    <nav aria-label="主导航">
      <a href={base}>今日</a>
      {links.map((link) => <a href={`${base}${link.path}`}>{link.label}</a>)}
      {
        repositoryUrl && (
          <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        )
      }
    </nav>
  </div>
</header>
