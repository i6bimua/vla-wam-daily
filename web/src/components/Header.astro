---
const base = import.meta.env.BASE_URL;
const repository = import.meta.env.GITHUB_REPOSITORY;
const repositoryUrl = repository ? `https://github.com/${repository}` : null;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={base} aria-label="VLA/WAM Daily 首页">
      <span class="brand__mark" aria-hidden="true">V/W</span>
      <span>
        <strong>VLA/WAM Daily</strong>
        <small>Robotics research brief</small>
      </span>
    </a>
    <nav aria-label="主导航">
      <a href={base}>今日论文</a>
      <a href={`${base}#latest`}>最新研究</a>
      {
        repositoryUrl && (
          <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        )
      }
    </nav>
  </div>
</header>
