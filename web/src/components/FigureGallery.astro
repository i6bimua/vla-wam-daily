---
import {
  figurePanelDownloadFilename,
  resolveFigurePanelSource,
} from "../lib/figures";
import type { Paper } from "../lib/schema";

interface Props {
  gallery: Paper["figure_gallery"];
  arxivId: string;
  version: number;
  pdfUrl: string;
}

const { gallery, arxivId, version, pdfUrl } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const headingId = `figures-${arxivId.replace(".", "-")}`;

function statusMessage(status: Paper["figure_gallery"]["status"]): string {
  switch (status) {
    case "html_unavailable":
      return "arXiv 暂未提供 HTML 版本，无法提取 Fig. 1 / Fig. 2。";
    case "not_found":
      return "在 arXiv HTML 中未找到 Fig. 1 / Fig. 2。";
    case "fetch_failed":
      return "本次获取 Fig. 1 / Fig. 2 失败，论文其它内容仍可正常阅读。";
    case "available":
      return "";
  }
}
---

<section class="figure-gallery" aria-labelledby={headingId}>
  <header class="figure-gallery__heading">
    <div>
      <p class="figure-gallery__kicker">CACHED FIGURES</p>
      <h3 id={headingId}>Fig. 1 &amp; Fig. 2</h3>
    </div>
    {
      gallery.status !== "html_unavailable" && (
        <a
          href={gallery.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="figure-gallery__html-link"
        >
          arXiv HTML <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </header>

  {
    gallery.status === "available" ? (
      <div class="figure-gallery__grid">
        {gallery.figures.map((figure) => (
          <figure class="remote-figure">
            <header class="remote-figure__heading">
              <p>{figure.label}</p>
              <a
                href={figure.source_url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`在 arXiv HTML 中定位 ${figure.label}`}
              >
                定位原文 <span aria-hidden="true">↗</span>
              </a>
            </header>
            <div
              class:list={[
                "remote-figure__panels",
                {
                  "remote-figure__panels--multiple":
                    figure.image_urls.length > 1,
                },
              ]}
            >
              {figure.image_urls.map((imageUrl, index) => {
                const panel = index + 1;
                const panelName = `面板 ${panel}/${figure.image_urls.length}`;
                const panelAlt = `${figure.label}，${panelName}：${figure.caption}`;
                const source = resolveFigurePanelSource({
                  originalUrl: imageUrl,
                  cachedPath: figure.cached_image_paths[index],
                  basePath,
                });
                const filename = figurePanelDownloadFilename({
                  arxivId,
                  version,
                  figure: figure.number,
                  panel,
                  source,
                });
                return (
                  <div class="remote-figure__panel" data-figure-panel>
                    <div class="remote-figure__media">
                      <img
                        src={source.displayUrl}
                        alt={panelAlt}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        data-figure-image
                      />
                      <div
                        class="figure-load-error"
                        data-figure-error
                        role="status"
                        hidden
                      >
                        <p>该面板暂时无法加载。</p>
                        <a
                          href={source.originalUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          查看 arXiv 原图 <span aria-hidden="true">↗</span>
                        </a>
                        <a
                          href={pdfUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          查看 PDF <span aria-hidden="true">↗</span>
                        </a>
                      </div>
                    </div>
                    <div class="remote-figure__actions">
                      <span>
                        {figure.image_urls.length > 1 ? panelName : "原始图像"}
                      </span>
                      <a
                        href={source.originalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`查看 ${figure.label} ${panelName} 原图`}
                      >
                        查看 arXiv 原图 <span aria-hidden="true">↗</span>
                      </a>
                      {source.isLocal ? (
                        <a
                          href={source.downloadUrl}
                          download={filename}
                          aria-label={`下载 ${figure.label} ${panelName} 原图`}
                        >
                          下载本站缓存
                        </a>
                      ) : (
                        <button
                          type="button"
                          aria-label={`下载 ${figure.label} ${panelName} 原图`}
                          data-figure-download
                          data-download-url={source.originalUrl}
                          data-download-name={filename}
                          data-arxiv-id={arxivId}
                          data-version={version}
                          data-figure-number={figure.number}
                          data-panel-number={panel}
                        >
                          下载原图
                        </button>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
            <figcaption class="remote-figure__caption">
              <strong>{figure.label}.</strong> {figure.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div
        class="figure-gallery__fallback"
        data-figure-status={gallery.status}
        role="status"
      >
        <p>{statusMessage(gallery.status)}</p>
        <a href={pdfUrl} target="_blank" rel="noopener noreferrer">
          查看 PDF <span aria-hidden="true">↗</span>
        </a>
      </div>
    )
  }

  <p class="figure-gallery__notice">
    Figure 面板优先从本站本地缓存加载；查看与复用时请以 arXiv
    原图及论文许可为准，版权归论文作者或相应权利人所有。
  </p>
</section>

<script>
  import {
    figureDownloadFilename,
    isTrustedArxivImageUrl,
    readTrustedArxivImageResponse,
  } from "../lib/figure-download";

  function openOriginal(url: string): void {
    const opened = window.open(url, "_blank", "noopener,noreferrer");
    if (opened) opened.opener = null;
    else window.location.assign(url);
  }

  function markFigureImageFailed(image: HTMLImageElement): void {
    image.hidden = true;
    const panel = image.closest<HTMLElement>("[data-figure-panel]");
    panel?.classList.add("remote-figure__panel--error");
    panel
      ?.querySelector<HTMLElement>("[data-figure-error]")
      ?.removeAttribute("hidden");
  }

  document
    .querySelectorAll<HTMLImageElement>("[data-figure-image]")
    .forEach((image) => {
      image.addEventListener("error", () => markFigureImageFailed(image));
      if (image.complete && image.naturalWidth === 0) {
        markFigureImageFailed(image);
      }
    });

  document
    .querySelectorAll<HTMLButtonElement>("[data-figure-download]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        if (button.dataset.downloadBusy === "true") return;
        const url = button.dataset.downloadUrl;
        const arxivId = button.dataset.arxivId;
        const version = Number(button.dataset.version);
        const figure = Number(button.dataset.figureNumber);
        const panel = Number(button.dataset.panelNumber);
        if (
          !url ||
          !arxivId ||
          !isTrustedArxivImageUrl(url, arxivId, version)
        ) {
          return;
        }

        let filename: string;
        try {
          filename = figureDownloadFilename({
            arxivId,
            version,
            figure,
            panel,
            imageUrl: url,
          });
        } catch {
          return;
        }

        const originalLabel = button.textContent;
        button.dataset.downloadBusy = "true";
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.textContent = "正在下载…";
        try {
          const response = await fetch(url, {
            mode: "cors",
            credentials: "omit",
            referrerPolicy: "no-referrer",
            redirect: "follow",
          });
          const blob = await readTrustedArxivImageResponse(response, {
            arxivId,
            version,
          });
          const objectUrl = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = objectUrl;
          link.download = filename;
          link.hidden = true;
          document.body.append(link);
          try {
            link.click();
          } finally {
            link.remove();
            window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1_000);
          }
        } catch {
          openOriginal(url);
        } finally {
          delete button.dataset.downloadBusy;
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.textContent = originalLabel ?? "下载原图";
        }
      });
    });
</script>
